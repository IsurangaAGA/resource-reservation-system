# Copy to .env and adjust for your environment.

# PostgreSQL connection string (database must exist; run `npm run db:deploy` to create tables).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resource_reservations?schema=public"

# Time zone used to display times and interpret booking input (IANA name).
# NEXT_PUBLIC_ variables are inlined at build time, so rebuild after changing it.
NEXT_PUBLIC_APP_TIME_ZONE="Asia/Colombo"

# Show the seeded demo logins on the sign-in page in production builds
# (they are always shown in development). Leave unset for real deployments.
# SHOW_DEMO_ACCOUNTS="true"
